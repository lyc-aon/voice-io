// Resources linked into voice-io.exe and "Voice IO.exe" by
// scripts/build-windows, which fills in the __VERSION*__ placeholders.
1 ICON "voice-io.ico"
1 24 "voice-io.manifest"

1 VERSIONINFO
FILEVERSION __VERSIONC__
PRODUCTVERSION __VERSIONC__
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Integral Inference Incorporated and Trinity Inference Systems Incorporated"
      VALUE "FileDescription", "Voice IO"
      VALUE "FileVersion", "__VERSION__"
      VALUE "InternalName", "voice-io"
      VALUE "LegalCopyright", "Copyright (c) 2026 Integral Inference Incorporated and Trinity Inference Systems Incorporated. MIT License."
      VALUE "ProductName", "Voice IO"
      VALUE "ProductVersion", "__VERSION__"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
