# Template: opt in explicitly with `scripts/install --desktop` after validating
# models and audio. Existing user services are never overwritten by bootstrap.
# Import session vars for a Linux desktop if needed:
#   systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP DBUS_SESSION_BUS_ADDRESS
[Unit]
Description=voice-io dictation daemon
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/voice-io.sh run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
