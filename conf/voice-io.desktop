# Template installed by `scripts/install --desktop` on Linux.
# The installer resolves all Exec lines to the installed launcher's absolute path.
[Desktop Entry]
Type=Application
Name=voice-io
Comment=Local dictation, meeting notes, and collaborative prompting
Exec=voice-io.sh start
Icon=voice-io
Terminal=false
Categories=AudioVideo;Audio;
StartupNotify=true
Actions=settings;quit;

[Desktop Action settings]
Name=Settings
Exec=voice-io.sh settings

[Desktop Action quit]
Name=Quit voice-io
Exec=voice-io.sh stop
